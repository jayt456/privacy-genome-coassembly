# config.env.example
# Copy to config.env and fill in your paths.
# Source this in pipeline scripts or your ~/.bashrc.
#
# Usage in a script:
#   [[ -f "$(dirname "$0")/../../config.env" ]] && source "$(dirname "$0")/../../config.env"
#   BASE="${COASM_BASE:-/default/path}"

# Project storage: assemblies, results, reference files
# Must contain: reference/hg38*.fa, genes.txt, {pedigree,hprc}_results/
export COASM_BASE=/nfs/roberts/project/pi_hc878/jst72

# Scratch storage: large intermediates (HPRC 12x assemblies, temp FASTQs)
export COASM_SCRATCH=/nfs/roberts/scratch/pi_hc878/jst72

# Path to this repo's src/ directory (Python tools)
# Set this if you cloned the repo somewhere other than $COASM_BASE/src/
# export COASM_TOOLS=/path/to/repo/src

# Conda env with jellyfish + BioPython (for ffind.py and build_k21_all_genes.sh)
# export BIOTOOLS_ENV=$HOME/.conda/envs/biotools

# Optional: explicit path to gfatools if not in PATH
# export GFATOOLS=/path/to/gfatools
